    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "H\u01AF\u1EDANG D\u1EAAN\n\nWASD \u0111i \u2022 Shift ch\u1EA1y \u2022
    Space nh\u1EA3y\nChu\u1ED9t nh\xECn \u2022 V \u0111\u1ED5i g\xF3c nh\xECn\nE
    m\u1EDF c\u1EEDa chu\u1ED3ng / l\u1EA5y s\u1EEFa, l\xF4ng, th\u1ECBt, tr\u1EE9ng\nChu\u1ED9t
    tr\xE1i nh\u1EA5c th\xFA \u2022 chu\u1ED9t ph\u1EA3i th\u1EA3 \u0111\xFAng chu\u1ED3ng\n1\u20133
    ch\u1ECDn h\u1EA1t \u2022 E c\xE0y, gieo, t\u01B0\u1EDBi, thu ho\u1EA1ch\nB m\u1EDF
    shop \u2022 I m\u1EDF t\xFAi \u0111\u1ED3 / b\xE1n s\u1EA3n ph\u1EA9m\nM\u1ED7i
    chu\u1ED3ng g\xE0 t\u1ED1i \u0111a 5 con; nh\u1EB7t tr\u1EE9ng \u1EDF \u1ED5\nEsc
    ti\u1EBFp t\u1EE5c / \u0111\xF3ng shop ho\u1EB7c t\xFAi \u0111\u1ED3\n\nGame
    t\u1EF1 l\u01B0u; nh\u1EA5n L\u01B0u game \u0111\u1EC3 l\u01B0u ngay."
