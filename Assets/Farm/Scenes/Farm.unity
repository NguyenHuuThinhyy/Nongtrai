    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "H\u01AF\u1EDANG D\u1EAAN\n\nWASD \u0111i \u2022 Shift ch\u1EA1y \u2022
    Space nh\u1EA3y\nChu\u1ED9t nh\xECn \u2022 V \u0111\u1ED5i g\xF3c nh\xECn \u2022
    E t\u01B0\u01A1ng t\xE1c\n1\u20133 H\u1EA1t \u2022 5 Cu\u1ED1c \u2022 6 T\u01B0\u1EDBi
    \u2022 7 Li\u1EC1m\nL\u1EA5y n\u01B0\u1EDBc \u1EDF h\u1ED3; x\xE2y tr\u1EA1m
    t\u01B0\u1EDBi t\u1EEB b\u1EA3ng c\u1EA1nh h\u1ED3\nF cho th\xFA \u0103n \u2022
    Chu\u1ED9t tr\xE1i nh\u1EA5c, ph\u1EA3i th\u1EA3\nB Shop \u2022 I T\xFAi \u2022
    M Ch\u1EBF bi\u1EBFn \u2022 Tab B\u1EA3n \u0111\u1ED3\nN M\u1EDF \u0111\u1EA5t
    & d\u1EE5ng c\u1EE5 \u2022 P Qu\u1EA3n l\xFD chu\u1ED3ng\nB\xE0n ch\u1EBF t\u1EA1o
    v\xE0 h\u1ED9p th\u01B0 \u1EDF tr\u01B0\u1EDBc nh\xE0\nS\xE1ng t\u1EA1o: F8 bay
    \u2022 Space l\xEAn \u2022 Ctrl xu\u1ED1ng\n\nTho\xE1t kh\xF4ng t\u1EF1 l\u01B0u.
    Nh\u1EA5n L\u01B0u game \u0111\u1EC3 l\u01B0u."
